    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from sklearn.metrics import accuracy_score, roc_auc_score\n",
        "import lightgbm as lgb\n",
        "\n",
        "print(\"=== [LightGBM] 저장된 전처리 데이터 로드 ===\")\n",
        "X_train_scaled = pd.read_csv('X_train_scaled.csv')\n",
        "X_test_scaled = pd.read_csv('X_test_scaled.csv')\n",
        "y_train = pd.read_csv('y_train.csv').iloc[:, 0]\n",
        "y_test = pd.read_csv('y_test.csv').iloc[:, 0]\n",
        "\n",
        "print(\"\\n=== LightGBM 모델 학습 시작 ===\")\n",
        "lgb_model = lgb.LGBMClassifier(random_state=42, n_estimators=100, max_depth=5, verbose=-1)\n",
        "lgb_model.fit(X_train_scaled, y_train)\n",
        "\n",
        "# 평가\n",
        "lgb_pred = lgb_model.predict(X_test_scaled)\n",
        "lgb_proba = lgb_model.predict_proba(X_test_scaled)[:, 1]\n",
        "print(f\"[결과] LightGBM Accuracy: {accuracy_score(y_test, lgb_pred):.4f}\")\n",
        "print(f\"[결과] LightGBM AUC: {roc_auc_score(y_test, lgb_proba):.4f}\")\n",
        "\n",
        "# 모델 저장\n",
        "lgb_model.booster_.save_model('lgb_model.txt')\n",
        "print(\"=== LightGBM 학습 및 저장 완료 ===\")"
      ],
      "metadata": {
        "colab": {
