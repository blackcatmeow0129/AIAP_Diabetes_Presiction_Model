    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import xgboost as xgb\n",
        "from sklearn.cluster import KMeans\n",
        "import shap\n",
        "\n",
        "print(\"=== [분석 단계] 데이터 및 XGBoost 모델 로드 ===\")\n",
        "X_train_scaled = pd.read_csv('X_train_scaled.csv')\n",
        "X_train_raw = pd.read_csv('X_train_raw.csv')\n",
        "y_train = pd.read_csv('y_train.csv').iloc[:, 0]\n",
        "\n",
        "# 저장했던 XGBoost 모델 로드\n",
        "xgb_model = xgb.XGBClassifier()\n",
        "xgb_model.load_model('xgb_model.json')\n",
        "\n",
        "print(\"\\n=== SHAP 가치(Value) 계산 시작 ===\")\n",
        "explainer = shap.Explainer(xgb_model, X_train_scaled)\n",
        "shap_values = explainer(X_train_scaled)\n",
        "\n",
        "# SHAP 시각화\n",
        "plt.figure(figsize=(10, 6))\n",
        "shap.summary_plot(shap_values, X_train_scaled, show=False)\n",
        "plt.title(\"SHAP Summary Plot\", fontsize=14)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\n=== SHAP 기반 K-Means 클러스터링 진행 ===\")\n",
        "shap_matrix = shap_values.values\n",
        "\n",
        "# 3개의 하위 그룹으로 군집화\n",
        "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
        "cluster_labels = kmeans.fit_predict(shap_matrix)\n",
        "\n",
        "# 결과 매핑 및 분석\n",
        "analysis_df = X_train_raw.copy()\n",
        "analysis_df['Cluster'] = cluster_labels\n",
        "analysis_df['Actual_Outcome'] = y_train.values\n",
        "\n",
        "# 군집별 통계량 요약\n",
        "cluster_summary = analysis_df.groupby('Cluster').agg(\n",
        "    Count=('Actual_Outcome', 'count'),\n",
        "    Diabetes_Rate=('Actual_Outcome', 'mean'), # 이 수치가 높은 군집이 고위험군!\n",
        "    Mean_Glucose=('Glucose', 'mean'),\n",
        "    Mean_BMI=('BMI', 'mean'),\n",
        "    Mean_Age=('Age', 'mean')\n",
        ").reset_index()\n",
        "\n",
        "print(\"\\n========================================================\")\n",
        "print(\"🎯 [최종 결과] SHAP 클러스터링 분석 요약\")\n",
        "print(\"========================================================\")\n",
        "print(cluster_summary.to_string(index=False))\n",
        "print(\"========================================================\")\n",
        "\n",
        "# 시각화\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.barplot(data=cluster_summary, x='Cluster', y='Diabetes_Rate', palette='muted')\n",
        "plt.axhline(y=y_train.mean(), color='red', linestyle='--', label='Overall Average')\n",
        "plt.title(\"Diabetes Risk Rate by SHAP-Based Cluster\", fontsize=14)\n",
        "plt.ylabel(\"Diabetes Ratio\")\n",
        "plt.xlabel(\"SHAP Cluster\")\n",
        "plt.legend()\n",
        "plt.show()"
      ],
